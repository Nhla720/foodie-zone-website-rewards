DATABASE_URL=postgresql://...
JWT_SECRET=replace-with-a-long-random-secret
RESEND_API_KEY=re_...
# Until you verify your own domain in Resend, only onboarding@resend.dev works and it can ONLY email your own Resend account address.
EMAIL_FROM=Foodie Zone <onboarding@resend.dev>
NEXT_PUBLIC_ORDER_ONLINE_URL=https://www.foodbooking.com/
ADMIN_EMAIL=admin@example.com

# One-time bootstrap for the first admin account. Set these, deploy, log in once at
# /admin/login with them, then you can remove the two lines (they only ever create
# the account once — they never overwrite an existing user). After that, manage
# further admins from the in-app Staff accounts page instead.
ADMIN_SEED_EMAIL=owner@example.com
ADMIN_SEED_PASSWORD=replace-with-a-strong-password

# Optional legacy fallback only — the primary admin auth is now per-account login
# above. Leave unset unless you have an external script/integration that still
# calls the admin API directly with this header.
ADMIN_KEY=

PURCHASE_WEBHOOK_KEY=replace-with-a-long-random-integration-key
NEXT_PUBLIC_APP_URL=https://rewards-foodie-zone.vercel.app
